# Copy this file to .env.local and adjust. .env.local is ignored by Git.
# Next.js reads it when `npm run dev` / `npm run build` starts: restart after changing it.

# Where the DoorKart backend is running (no trailing slash, no /api/v1).
# Next.js proxies API and uploaded media requests here; this address must be reachable
# from the Next.js server. Rebuild production after changing it.
# The backend's CORS_ORIGINS must still contain THIS app's address
# (http://localhost:3000 in development). Production login requires HTTPS on the panel.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
