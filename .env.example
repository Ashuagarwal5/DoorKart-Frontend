# Copy this file to .env.local and adjust. .env.local is ignored by Git.
# Next.js reads it when `npm run dev` / `npm run build` starts: restart after changing it.

# Where the DoorKart backend is running (no trailing slash, no /api/v1).
# The browser calls this address directly, so it must be reachable from the browser.
# The backend's CORS_ORIGINS must contain THIS app's address (http://localhost:3000 in
# development), or the browser will refuse to send the sign-in cookie.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
