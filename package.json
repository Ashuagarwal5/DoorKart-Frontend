{
    "name": "doorkart-admin",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "docker:up": "docker compose --env-file .env.docker up --build -d",
