        "react-hot-toast": "^2.6.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "eslint": "^9",
        "eslint-config-next": "16.3.8",
        "tailwindcss": "^4",
        "vitest": "^5.0.3"
    }
