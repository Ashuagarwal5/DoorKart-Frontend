# Settings for the admin panel Docker stack. Copy to .env.docker and edit; never commit .env.docker.

# Where the DoorKart backend is reachable FROM THIS SERVER: an origin only, no trailing slash,
# no /api/v1 (for example https://api.doorkart.in). The browser talks to the admin panel's own
# address; the admin panel forwards API and upload requests here.
# It is read while the image is built: rebuild after changing it (npm run docker:up).
NEXT_PUBLIC_API_BASE_URL=https://api.doorkart.in

# Host port the admin panel listens on (put your HTTPS reverse proxy in front of it).
ADMIN_PORT=3000
